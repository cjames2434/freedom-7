{
  "siteName": "Freedom 7",
  "tagline": "Every side of the story, side by side.",

  "windowHours": 48,
  "maxItemsPerFeed": 40,
  "fetchTimeoutMs": 15000,
  "fetchConcurrency": 6,

  "cluster": {
    "threshold": 0.22,
    "maxHoursApart": 36,
    "sameSourcePenalty": 0.8
  },

  "minSourcesForStory": 2,
  "minPartisanSourcesForBlindspot": 3,
  "blindspotShare": 0.8,
  "maxStories": 150,
  "recencyHalfLifeHours": 12,

  "developing": {
    "windowHours": 3,
    "minRecentSources": 3
  },

  "related": {
    "minSimilarity": 0.2,
    "strongSimilarity": 0.4,
    "maxRelated": 5
  },

  "headline": {
    "takeTurns": true,
    "turnMargin": 0.5
  },

  "markets": {
    "watch": [
      { "id": "nvidia", "name": "NVIDIA", "terms": ["nvidia", "jensen huang"] },
      { "id": "spacex", "name": "SpaceX", "terms": ["spacex", "space x", "starship", "starlink", "starshield", "falcon 9"] }
    ],
    "minOutlets": 2,
    "minShare": 0.4
  },

  "digest": {
    "maxPerSide": 2,
    "minNewWords": 3
  },

  "perspectives": {
    "threshold": 0.12,
    "maxPerSide": 2,
    "maxEntityShare": 0.08
  },

  "safety": {
    "minOutletShare": 0.5,
    "minArticles": 30
  },

  "ai": {
    "model": "claude-opus-5-5",
    "effort": "low",
    "minSources": 3,
    "maxPerRun": 12,
    "concurrency": 3,
    "regenerateAfterHours": 3
  }
}
