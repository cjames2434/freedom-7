# Copy to .env for local builds. Everything here is optional.

# Turns on neutral AI briefs for stories covered by 3+ outlets.
# Leave unset and the site still works (it shows the plainest real headline).
ANTHROPIC_API_KEY=

# Which Claude model writes the briefs (default from config/settings.json: claude-opus-5-5).
# claude-haiku-5-5 is far cheaper; see README "AI briefs and cost".
# SUMMARY_MODEL=claude-opus-5-5

# low | medium | high. Default low.
# SUMMARY_EFFORT=low

# Cap on new briefs per build (default 12).
# SUMMARY_MAX_PER_RUN=12

# Set to "off" to disable briefs even when a key is present.
# AI_SUMMARIES=off
